# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Production: existing canonical absolute directory, outside deployed source.
# Prepare .amazonia-storage manually only after inventory if no SQLite exists.
# AMAZONIA_CAMPAIGNS_DIR=/var/lib/amazonia/campaigns
# API remains closed until a reviewed portal authorization adapter is integrated.
# 1B.5: file outside source, regular file mode 0600/0400, owned by service account.
# ATELIER_INTERNAL_KEY_FILE=/etc/amazonia/internal-key
# ATELIER_PUBLIC_ORIGINS=https://atelierconceptionjeu.fr,https://www.atelierconceptionjeu.fr
